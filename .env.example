# Copy to .env in your working directory. Shell variables take precedence.
CAPSOLVER_API_KEY=
# Hosted model for required-field assessment, mapping and optional drafting.
OPENAI_API_KEY=
WAGECUCK_AGENT_PROVIDER=openai
WAGECUCK_AGENT_MODEL=gpt-5.6-terra
# Optional override. Leave blank for the provider's standard endpoint.
WAGECUCK_AGENT_ENDPOINT=
# For local inference instead: provider=ollama, model=YOUR_INSTALLED_MODEL.
